---
// A song recommendation card for posts: cover, a Winamp-ish LCD deck with the title,
// and links out to several platforms.
// Usage in MDX: <SongRecc spotify="https://open.spotify.com/track/…" />
//           or: <SongRecc title="Spectator" artist="Friday Pilots Club" />
// Any children render as a short note under the links.
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getSong, type SongQuery } from '../songs/resolve';

type Props = SongQuery;
const song = await getSong(Astro.props);

// Covers live in src/songs/art/ so astro:assets optimises them as local files. A song
// resolved for the first time isn't in this build's glob yet, so it falls back to the
// remote URL once; every later build uses the committed file.
const covers = import.meta.glob<{ default: ImageMetadata }>('../songs/art/*.{jpg,png,webp}', { eager: true });
const art = (song.artFile && covers[`../songs/art/${song.artFile}`]?.default) || song.art;

const links = [
  { href: song.links.spotify, icon: 'simple-icons:spotify', label: 'spotify' },
  { href: song.links.apple, icon: 'simple-icons:applemusic', label: 'apple music' },
  { href: song.links.ytmusic, icon: 'simple-icons:youtubemusic', label: 'yt music' },
  { href: song.links.songlink, icon: 'lucide:link', label: 'song.link' },
].filter((l) => l.href);
---
<aside class="sr">
  <div class="art">
    {art
      ? <Image src={art} width={72} height={72} densities={[1, 2]} alt={`cover art for ${song.title}`} />
      : <Icon name="lucide:disc-3" size={32} />}
  </div>
  <div class="main">
    <div class="deck">
      <span class="name"><span class="artist">{song.artist}</span> - {song.title}</span>
    </div>
    <div class="outs">
      <span class="label">// play on:</span>
      {links.map((l) => (
        <a href={l.href} target="_blank" rel="noopener noreferrer">
          <Icon name={l.icon} size={12} />{l.label}
        </a>
      ))}
    </div>
    {Astro.slots.has('default') && <div class="note"><slot /></div>}
  </div>
</aside>

<style>
  .sr {
    display: flex;
    gap: 14px;
    align-items: stretch;
    margin: 1.6em 0;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: 5px;
    font-style: normal;
    transition: border-color 0.18s;
  }
  .sr:hover { border-color: color-mix(in srgb, var(--accent) 55%, transparent); }

  .art {
    flex: none;
    /* = deck + gap + links row, so the cover and text column end flush */
    width: 72px;
    height: 72px;
    display: grid;
    place-items: center;
    border-radius: 3px;
    overflow: hidden;
    background: var(--bg-2);
    color: var(--txt-4);
  }
  .art img { display: block; width: 100%; height: 100%; object-fit: cover; margin: 0; border: 0; border-radius: 0; }

  .main { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 12px; }

  /* the LCD panel */
  .deck {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 3px;
    overflow: hidden;
  }

  .name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-family: var(--term);
    font-size: 21px;
    line-height: 1;
    color: var(--accent);
  }
  .artist { color: var(--txt-2); }

  .outs { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; font-size: 12px; }
  .label { color: var(--txt-4); margin-right: 2px; }
  .outs a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--txt-3);
    border-bottom: none;
    transition: color 0.15s;
  }
  .outs a:hover { color: var(--accent); }
  .outs a :global(svg) { flex: none; }

  .note { font-size: 13px; color: var(--txt-3); }
</style>
